{
	"name": "amortexa-mortgage-calculator",
	"version": "1.0.0",
	"description": "An interactive mortgage calculator block with live payment results, down payment, recurring costs, charts, and an amortization schedule.",
	"author": "Muhammad Tariq",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"block",
		"mortgage",
		"calculator"
	],
	"homepage": "https://wordpress.org/plugins/amortexa-mortgage-calculator/",
	"repository": {
		"type": "git",
		"url": "https://wordpress.org/plugins/amortexa-mortgage-calculator/"
	},
	"bugs": {
		"url": "https://wordpress.org/support/plugin/amortexa-mortgage-calculator/"
	},
	"files": [
		"amortexa-mortgage-calculator.php",
		"uninstall.php",
		"readme.txt",
		"LICENSE",
		"plugin.json",
		"build",
		"languages",
		"assets",
		"includes"
	],
	"devDependencies": {
		"@babel/parser": "^7.29.9",
		"@babel/runtime": "^7.29.7",
		"@babel/traverse": "^7.29.8",
		"@wordpress/block-editor": "^18.0.0",
		"@wordpress/blocks": "^16.1.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/scripts": "^35.0.0",
		"adm-zip": "^0.6.1",
		"jsdom": "^20.0.3",
		"typescript": "~5.5.4",
		"wp-pot": "^2.0.0"
	},
	"scripts": {
		"build": "wp-scripts build && node tools/strip-bom.cjs && node tools/sync-block-version.cjs",
		"start": "wp-scripts start",
		"dev": "wp-scripts start",
		"lint:js": "wp-scripts lint-js src assets webpack.config.js",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\" \"src/**/*.css\" \"assets/**/*.css\"",
		"lint:pkg-json": "wp-scripts lint-pkg-json .",
		"lint:md": "wp-scripts lint-md-docs README.md",
		"packages-update": "wp-scripts packages-update",
		"make-pot": "node tools/make-pot.cjs",
		"render-assets": "node tools/render-assets.cjs",
		"test": "php tests/parity.php && node tests/js/admin.mjs",
		"dist": "node tools/build-dist.cjs",
		"release": "npm run build && npm run make-pot && npm run render-assets && npm run dist",
		"test:admin": "node tests/js/admin.mjs"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	]
}
