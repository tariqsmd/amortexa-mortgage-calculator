# Files excluded from a WordPress.org release.
#
# `npm run dist` (tools/build-dist.cjs) uses an explicit allowlist and is the
# canonical way to build a release. This file is a second safety net for anyone
# who builds with `wp dist-archive` from the 10up/wp-cli-dist-archive package
# instead, so that the two methods cannot disagree about what ships.

# Dependencies and tooling
node_modules
vendor
package.json
package-lock.json
webpack.config.js
babel.config.js
phpcs.xml.dist

# Development sources and tooling. Directory guideline #4 is satisfied by the
# public GitHub repository linked from readme.txt, so the unminified sources
# stay out of the download rather than being duplicated into it.
src/**/*.js
src/edit
src/utils
src/*.scss
src/index.css
tools
tests
eslint.config.js

# `includes/` is deliberately NOT excluded: amortexa-mortgage-calculator.php requires it on every
# request, so shipping without it produces a plugin that fatals on activation.

# Repository documentation (readme.txt and LICENSE always ship)
README.md
.gitignore
.distignore
.github
.git

# Local-only notes. Both are ignored by git as well; listed here because
# `wp dist-archive` reads this file rather than .gitignore, so without these two
# lines a `wp dist-archive` build would package working notes that
# `npm run dist` correctly leaves out.
PUBLISHING.md
NEXT-VERSION.md

# Editor and OS noise
.DS_Store
Thumbs.db
*.log
*.map
*.zip
dist
