# Dependencies
node_modules/
vendor/

# Build and release output
/dist/
*.zip
*.tar.gz

# Tooling caches and local config
.wp-env.json
.wp-env.override.json
.phpunit.result.cache
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local-only submission notes. This is a personal working checklist rather than
# contributor documentation, so it is deliberately not tracked and never ships
# in the package.
/PUBLISHING.md

# Source maps are not committed; the compiled build/ folder is.
*.map

# Lock files for dev tooling
composer.lock

# Note: LICENSE and readme.txt are intentionally NOT ignored. The WordPress.org
# guidelines require the license to be shipped with the plugin, so never add
# them here.

# Generated listing artwork. The PNGs under .wordpress-org/assets/ are rasterised
# from the versioned vectors in assets-src/ by `npm run render-assets`, so they
# are build output rather than source and are not tracked. They are still copied
# into dist/assets/ for the WordPress.org upload, which means anyone building a
# submission package must run `npm run render-assets` first.
/.wordpress-org/assets/
