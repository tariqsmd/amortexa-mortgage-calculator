# Dependencies
node_modules/
vendor/

# Build and release output
/build/
/dist/
*.zip
*.tar.gz

# Tooling caches and local config
.wp-env.json
.wp-env.override.json
.phpunit.result.cache
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local-only submission notes. This is a personal working checklist rather than
# contributor documentation, so it is deliberately not tracked and never ships
# in the package.
/PUBLISHING.md

# Source maps are not committed; build/ is regenerated by `npm run build`.
*.map

# Note: LICENSE and readme.txt are intentionally NOT ignored. The WordPress.org
# guidelines require the license to be shipped with the plugin, so never add
# them here.

# Listing artwork is not versioned for now. assets-src/ holds the authored
# vectors and .wordpress-org/assets/ holds the PNGs rasterised from them; both
# live only on the machine that builds the submission package. Run
# `npm run render-assets` before `npm run release` to regenerate the PNGs.
/assets-src/
/.wordpress-org/assets/
