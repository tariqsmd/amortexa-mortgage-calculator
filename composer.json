{
	"name": "tariq/mortgage-calculator-block",
	"description": "A native Gutenberg block providing an interactive mortgage calculator.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Tariq",
			"homepage": "https://example.com/"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml.dist --report=summary",
		"lint:fix": "phpcbf --standard=phpcs.xml.dist"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
