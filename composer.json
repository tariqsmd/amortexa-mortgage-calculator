{
	"name": "calcforge/calcforge",
	"description": "An interactive mortgage calculator block for the block editor, with live monthly payments, charts and an amortization schedule.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Muhammad Tariq",
			"homepage": "https://profiles.wordpress.org/mtariqsmd/"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml.dist --report=summary",
		"lint:fix": "phpcbf --standard=phpcs.xml.dist",
		"test": "php tests/parity.php"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
