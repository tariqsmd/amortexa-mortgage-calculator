<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="CalcForge" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xml.dist">

	<description>WordPress Coding Standards for the CalcForge plugin.</description>

	<!-- Scan all PHP files in the project root and includes/src directories. -->
	<file>.</file>
	<!-- /dist is build output: without this every file is scanned three times
		once `npm run dist` has run (source, dist/trunk, dist/tags/<version>). -->
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- Enforce the plugin text domain on every translation function. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="calcforge"/>
		</properties>
	</rule>

	<!-- Only allow the documented global prefixes. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="calcforge_,CalcForge_,CALCFORGE_"/>
		</properties>
	</rule>

	<!-- Minimum WordPress version the plugin supports. -->
	<config name="minimum_supported_wp_version" value="6.4"/>

	<config name="testVersion" value="7.4-"/>
</ruleset>
