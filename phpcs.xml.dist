<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Amortexa Mortgage Calculator" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xml.dist">

	<description>WordPress Coding Standards for the Amortexa Mortgage Calculator plugin.</description>

	<!-- Scan all PHP files in the project root and includes/src directories. -->
	<file>.</file>
	<!-- /dist is build output: without this every file is scanned three times
		once `npm run dist` has run (source, dist/trunk, dist/tags/<version>). -->
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<!-- /tests is the harness, not shipped code. It defines its own stubs for
		WordPress functions and calls shell_exec(), which has no place in a
		release and trips escaping and file-handling sniffs by design. -->
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- Enforce the plugin text domain on every translation function. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="amortexa-mortgage-calculator"/>
			</property>
		</properties>
	</rule>

	<!-- Only allow the documented global prefixes. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="amortexa_"/>
				<element value="Amortexa_"/>
				<element value="AMORTEXA_"/>
			</property>
		</properties>
	</rule>

	<!-- This sniff wants class-settings.php renamed to class-amortexa-settings.php
		for every class. The plugin directory only asks for descriptive lowercase
		dashed names, which these already are, and Plugin Check does not raise it,
		so renaming seven files would decouple the include list from the classes it
		loads for no functional gain. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<severity>0</severity>
	</rule>

	<!-- The plugin bootstrap header is fixed by the maintainer and carries no
		@package tag, so this sniff is limited to the rest of the codebase. -->
	<rule ref="Squiz.Commenting.FileComment.MissingPackageTag">
		<exclude-pattern>amortexa-mortgage-calculator\.php</exclude-pattern>
	</rule>

	<!-- Minimum WordPress version the plugin supports. -->
	<config name="minimum_supported_wp_version" value="6.5"/>

	<config name="testVersion" value="7.4-"/>
</ruleset>
