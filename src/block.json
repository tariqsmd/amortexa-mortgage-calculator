{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "amortexa-mortgage-calculator/mortgage-calculator",
	"version": "1.0.0",
	"title": "Mortgage Calculator",
	"category": "amortexa-mortgage-calculator",
	"icon": "calculator",
	"description": "Interactive mortgage calculator with monthly payments, charts, and an amortization schedule.",
	"keywords": [ "mortgage", "loan", "calculator", "payment", "amortization" ],
	"textdomain": "amortexa-mortgage-calculator",
	"attributes": {
		"loanAmount": {
			"type": "number",
			"default": 300000
		},
		"downPayment": {
			"type": "number",
			"default": 0
		},
		"interestRate": {
			"type": "number",
			"default": 6.5
		},
		"loanTerm": {
			"type": "number",
			"default": 30
		},
		"propertyTax": {
			"type": "number",
			"default": 0
		},
		"propertyTaxUnit": {
			"type": "string",
			"default": "percent",
			"enum": [ "percent", "amount" ]
		},
		"homeInsurance": {
			"type": "number",
			"default": 0
		},
		"homeInsuranceUnit": {
			"type": "string",
			"default": "amount",
			"enum": [ "percent", "amount" ]
		},
		"hoaFee": {
			"type": "number",
			"default": 0
		},
		"hoaFeeUnit": {
			"type": "string",
			"default": "amount",
			"enum": [ "percent", "amount" ]
		},
		"pmi": {
			"type": "number",
			"default": 0
		},
		"pmiUnit": {
			"type": "string",
			"default": "amount",
			"enum": [ "percent", "amount" ]
		},
		"otherCosts": {
			"type": "number",
			"default": 0
		},
		"otherCostsUnit": {
			"type": "string",
			"default": "amount",
			"enum": [ "percent", "amount" ]
		},
		"showCosts": {
			"type": "boolean",
			"default": false
		},
		"currencySymbol": {
			"type": "string",
			"default": "$"
		},
		"currencyPosition": {
			"type": "string",
			"default": "prefix",
			"enum": [ "prefix", "suffix" ]
		},
		"chartType": {
			"type": "string",
			"default": "both",
			"enum": [ "donut", "line", "bar", "dots", "both" ]
		},
		"layout": {
			"type": "string",
			"default": "split",
			"enum": [ "stacked", "split" ]
		},
		"formColumns": {
			"type": "string",
			"default": "wide",
			"enum": [ "wide", "compact" ]
		},
		"panelOrder": {
			"type": "array",
			"default": [ "form", "results", "charts", "schedule" ],
			"items": {
				"type": "string",
				"enum": [ "form", "results", "charts", "schedule" ]
			}
		},
		"theme": {
			"type": "string",
			"default": "light",
			"enum": [
				"light",
				"dark",
				"ocean",
				"sunset",
				"forest",
				"midnight",
				"rose",
				"slate",
				"grape",
				"aqua",
				"mocha",
				"cyber",
				"emerald",
				"crimson",
				"charcoal",
				"copper",
				"royal",
				"amber",
				"cobalt",
				"fuchsia",
				"mint",
				"sand",
				"lemon",
				"steel"
			]
		},
		"showSliders": {
			"type": "boolean",
			"default": true
		},
		"showResults": {
			"type": "boolean",
			"default": true
		},
		"showAmortization": {
			"type": "boolean",
			"default": true
		},
		"showCharts": {
			"type": "boolean",
			"default": true
		},
		"paymentFontSize": {
			"type": "number",
			"default": 0
		},
		"paymentFontWeight": {
			"type": "string",
			"default": "",
			"enum": [ "", "300", "400", "500", "600", "700", "800" ]
		},
		"fontFamily": {
			"type": "string",
			"default": "inherit",
			"enum": [ "inherit", "sans", "serif", "mono" ]
		},
		"accentColor": {
			"type": "string",
			"default": ""
		},
		"accentAltColor": {
			"type": "string",
			"default": ""
		},
		"labelColor": {
			"type": "string",
			"default": ""
		},
		"fieldTextColor": {
			"type": "string",
			"default": ""
		},
		"fieldBackgroundColor": {
			"type": "string",
			"default": ""
		},
		"fieldBorderColor": {
			"type": "string",
			"default": ""
		},
		"design": {
			"type": "object",
			"default": {},
			"description": "Per-element appearance overrides, keyed by design token. Validated against the token schema in amortexa_sanitize_design()."
		}
	},
	"example": {
		"attributes": {
			"loanAmount": 350000,
			"downPayment": 70000,
			"interestRate": 5.5,
			"loanTerm": 30
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
