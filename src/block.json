{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mtgb/mortgage-calculator",
	"version": "1.2.0",
	"title": "MT Mortgage Calculator",
	"category": "mtgb",
	"icon": "calculator",
	"description": "Interactive mortgage calculator with monthly payments and amortization schedule.",
	"keywords": [ "mortgage", "loan", "calculator", "payment", "amortization" ],
	"textdomain": "mt-gutenberg-blocks",
	"attributes": {
		"loanAmount": {
			"type": "number",
			"default": 300000
		},
		"interestRate": {
			"type": "number",
			"default": 6.5
		},
		"loanTerm": {
			"type": "number",
			"default": 30
		},
		"downPayment": {
			"type": "number",
			"default": 60000
		},
		"currencySymbol": {
			"type": "string",
			"default": "$"
		},
		"currencyPosition": {
			"type": "string",
			"default": "prefix",
			"enum": [ "prefix", "suffix" ]
		},
		"showSliders": {
			"type": "boolean",
			"default": true
		},
		"showResults": {
			"type": "boolean",
			"default": true
		},
		"showAmortization": {
			"type": "boolean",
			"default": true
		},
		"showCharts": {
			"type": "boolean",
			"default": true
		},
		"chartType": {
			"type": "string",
			"default": "both",
			"enum": [ "donut", "line", "both" ]
		},
		"paymentFontSize": {
			"type": "number",
			"default": 0
		},
		"paymentFontWeight": {
			"type": "string",
			"default": ""
		},
		"theme": {
			"type": "string",
			"default": "light",
			"enum": [
				"light",
				"dark",
				"ocean",
				"sunset",
				"forest",
				"midnight",
				"rose",
				"slate",
				"grape",
				"aqua",
				"mocha",
				"cyber"
			]
		},
		"accentColor": {
			"type": "string",
			"default": ""
		},
		"accentAltColor": {
			"type": "string",
			"default": ""
		},
		"labelColor": {
			"type": "string",
			"default": ""
		},
		"fieldTextColor": {
			"type": "string",
			"default": ""
		},
		"fieldBackgroundColor": {
			"type": "string",
			"default": ""
		},
		"fieldBorderColor": {
			"type": "string",
			"default": ""
		},
		"fontFamily": {
			"type": "string",
			"default": "inherit",
			"enum": [ "inherit", "sans", "serif", "mono" ]
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"editorScript": "mtgb-editor-script",
	"editorStyle": "mtgb-editor-style"
}
